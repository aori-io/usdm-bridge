# Copy this file to `.env.local` and fill in the values, then restart `bun run dev`.
# (Next.js only reads env files at startup — it will NOT hot-reload new env vars.)

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Server-only Aori API key. Injected as `x-api-key` by the /api/aori proxy
# (src/pages/api/aori/[...path].ts). Without it, every Aori call — including the
# /chains and /domain calls the widget's SDK client needs to initialize — returns
# HTTP 500, and no quotes will be fetched. NOT exposed to the browser.
AORI_API_KEY=

# ── OPTIONAL: Relay API key (aggregator mode) ─────────────────────────────────
# Server-only Relay API key. Injected as `x-api-key` by the /api/relay proxy
# (src/pages/api/relay/[...path].ts). Relay quoting/execution works WITHOUT a key;
# a key raises rate limits. NOT exposed to the browser.
RELAY_API_KEY=

# ── RECOMMENDED: per-chain RPC URLs ───────────────────────────────────────────
# Proxied by /api/rpc/[chainId] and used for balance reads, allowance checks, and
# the on-chain wallet-screening oracle. Any chain left blank will fail RPC calls
# for that chain (quotes still work; balances/approvals for that chain won't).
ETHEREUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
MONAD_RPC_URL=
MEGAETH_RPC_URL=
PLASMA_RPC_URL=
BSC_RPC_URL=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Chainalysis sanctions-screening key used by /api/screening. If unset, screening
# fails open (every wallet is allowed).
CHAINALYSIS_API_KEY=
